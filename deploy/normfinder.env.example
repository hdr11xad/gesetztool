# Einstellungen des Normfinders – nach /etc/normfinder.env kopieren und anpassen.

# Datenverzeichnis: Cache, Stände (releases/), Symlink current, Logs
NORMFINDER_ROOT=/srv/normfinder

# Pfad auf der Website (mit Schrägstrich am Anfang und Ende)
NORMFINDER_BASE=/normfinder/

# Parallele Prozesse beim Erzeugen (der Server hat 8 Kerne; 4 lassen Luft für WordPress/Nextcloud)
NORMFINDER_WORKERS=4

# Mindestabstand zwischen zwei Downloads in Sekunden (Rate-Limit gegenüber gesetze-im-internet.de)
NORMFINDER_INTERVAL=0.3

# Meldung an Uptime Kuma (Monitor-Typ „Push“). Bei Erfolg „up“, bei Fehler „down“.
# Bleibt die Meldung aus (Heartbeat-Intervall z. B. 26 Stunden), schlägt Kuma ebenfalls Alarm.
# Die URL zeigt Kuma beim Anlegen des Push-Monitors an; 127.0.0.1:3001 ist Kuma auf diesem Server.
NORMFINDER_PUSH_URL=

# Optional: zusätzlich Mail bei Fehlern (nur wenn auf dem Server „sendmail“ eingerichtet ist)
NORMFINDER_MAIL=
